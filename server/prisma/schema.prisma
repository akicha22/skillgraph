generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String
  isDemo       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  candidateSkills CandidateSkill[]
}
model SkillDomain {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  sortOrder   Int      @default(0)
  skills      Skill[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Skill {
  id              String           @id @default(cuid())
  slug            String           @unique
  name            String
  description     String
  // comma-separated: STRUCTURED_RESPONSE,DATA_ANALYTICAL,FILE_SUBMISSION
  assessmentTypes String
  sortOrder       Int              @default(0)
  domainId        String
  domain          SkillDomain      @relation(fields: [domainId], references: [id])
  subskills       Subskill[]
  candidateSkills CandidateSkill[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([domainId])
}

model Subskill {
  id          String   @id @default(cuid())
  slug        String
  name        String
  description String?
  sortOrder   Int      @default(0)
  skillId     String
  skill       Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([skillId, slug])
  @@index([skillId])
}

model CandidateSkill {
  id        String   @id @default(cuid())
  userId    String
  skillId   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, skillId])
  @@index([skillId])
}