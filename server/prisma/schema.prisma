generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String
  isDemo       Boolean  @default(false)
  // Candidate profile, all optional so existing accounts stay valid.
  headline        String?
  location        String?
  about           String?
  yearsExperience Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  candidateSkills CandidateSkill[]
  assessments Assessment[]
  attempts    AssessmentAttempt[]
  auditLogs   AuditLog[]
  shortlists  Shortlist[]
  posts       RecruiterPost[]
  dailyTasks  DailyTask[]
}
model SkillDomain {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  sortOrder   Int      @default(0)
  skills      Skill[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Skill {
  id              String           @id @default(cuid())
  slug            String           @unique
  name            String
  description     String
  // comma-separated: STRUCTURED_RESPONSE,DATA_ANALYTICAL,FILE_SUBMISSION
  assessmentTypes String
  sortOrder       Int              @default(0)
  domainId        String
  domain          SkillDomain      @relation(fields: [domainId], references: [id])
  subskills       Subskill[]
  candidateSkills CandidateSkill[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  assessmentVersionSkills AssessmentVersionSkill[]
  assessmentTasks         AssessmentTask[]
  dailyTasks              DailyTask[]

  @@index([domainId])
}

model Subskill {
  id          String   @id @default(cuid())
  slug        String
  name        String
  description String?
  sortOrder   Int      @default(0)
  skillId     String
  skill       Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([skillId, slug])
  @@index([skillId])
}

model CandidateSkill {
  id        String   @id @default(cuid())
  userId    String
  skillId   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, skillId])
  @@index([skillId])
}
model Assessment {
  id          String              @id @default(cuid())
  ownerId     String
  owner       User                @relation(fields: [ownerId], references: [id])
  jobTitle    String
  companyName String
  versions    AssessmentVersion[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([ownerId])
}

model AssessmentVersion {
  id                    String                   @id @default(cuid())
  assessmentId          String
  assessment            Assessment               @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  versionNumber         Int
  status                String                   @default("DRAFT") // DRAFT | PUBLISHED
  requirementsText      String
  title                 String
  description           String
  jobContext            String
  candidateInstructions String
  targetLevel           String // INTERN | FRESHER | JUNIOR | MID | SENIOR
  difficulty            String // BEGINNER | INTERMEDIATE | ADVANCED
  durationMinutes       Int
  aiPolicy              String                   @default("NOT_ALLOWED") // NOT_ALLOWED | ALLOWED_DISCLOSED
  generationMethod      String // TEMPLATE | AI | MANUAL
  generationModel       String?
  generatedAt           DateTime?
  publishedAt           DateTime?
  skills                AssessmentVersionSkill[]
  tasks                 AssessmentTask[]
  attempts              AssessmentAttempt[]
  comparisonWeights     ComparisonWeights?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  @@unique([assessmentId, versionNumber])
}

// A recruiter's saved skill weights for comparing submissions of one version. Kept separate from
// AssessmentVersionSkill so a saved comparison preference never changes the assessment itself.
model ComparisonWeights {
  versionId String            @id
  version   AssessmentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  weights   String // JSON array of { skillId, weight }
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model AssessmentVersionSkill {
  // NEW: Store selected subskill slugs as JSON array
  selectedSubskills String @default("[]")
  id        String            @id @default(cuid())
  versionId String
  skillId   String
  weight    Int // percentage; weights in a version add up to 100
  source    String            @default("REQUESTED") // REQUESTED | SUGGESTED_APPROVED
  version   AssessmentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  skill     Skill             @relation(fields: [skillId], references: [id])

  @@unique([versionId, skillId])
  @@index([skillId])
}

model AssessmentTask {
  id          String                      @id @default(cuid())
  versionId   String
  position    Int
  type        String // STRUCTURED_RESPONSE | DATA_ANALYTICAL | FILE_SUBMISSION
  skillId     String
  title       String
  prompt      String
  marks       Int
  timeMinutes Int
  publicData  String                      @default("{}") // JSON text, candidate-visible
  privateData String                      @default("{}") // JSON text, NEVER sent to candidates
  version     AssessmentVersion           @relation(fields: [versionId], references: [id], onDelete: Cascade)
  skill       Skill                       @relation(fields: [skillId], references: [id])
  rubric      AssessmentRubricCriterion[]
  responses   AssessmentResponse[]

  @@unique([versionId, position])
  @@index([skillId])
}

model AssessmentAttempt {
  id          String               @id @default(cuid())
  versionId   String
  candidateId String
  status      String               @default("IN_PROGRESS") // IN_PROGRESS | SUBMITTED
  startedAt   DateTime             @default(now())
  submittedAt DateTime?
  reviewedAt  DateTime? // set once every rubric criterion has been scored
  updatedAt   DateTime             @updatedAt
  version     AssessmentVersion    @relation(fields: [versionId], references: [id], onDelete: Cascade)
  candidate   User                 @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  responses   AssessmentResponse[]
  criterionScores AssessmentCriterionScore[]
  shortlistEntries ShortlistEntry[]
  followUps    AttemptFollowUp[]
  events       AttemptEvent[]

  // One attempt per candidate per version keeps answers from splitting across duplicates.
  @@unique([versionId, candidateId])
  @@index([candidateId])
}

model AttemptEvent {
  id         String            @id @default(cuid())
  attemptId  String
  taskId     String?
  type       String
  occurredAt DateTime          @default(now())
  metadata   String?
  attempt    AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId, occurredAt])
}

model AssessmentResponse {
  id        String            @id @default(cuid())
  attemptId String
  taskId    String
  answer    String            @default("")
  savedAt   DateTime          @default(now()) @updatedAt
  attempt   AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  task      AssessmentTask    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([attemptId, taskId])
}

model AssessmentRubricCriterion {
  id              String         @id @default(cuid())
  taskId          String
  position        Int
  name            String // candidate-visible
  description     String // candidate-visible
  maxMarks        Int // candidate-visible
  privateGuidance String // evaluator-only
  task            AssessmentTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  scores          AssessmentCriterionScore[]

  @@unique([taskId, position])
}

// A recruiter's marks for one criterion of one submitted attempt.
model AssessmentCriterionScore {
  id          String                    @id @default(cuid())
  attemptId   String
  criterionId String
  marks       Int
  updatedAt   DateTime                  @default(now()) @updatedAt
  attempt     AssessmentAttempt         @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  criterion   AssessmentRubricCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, criterionId])
  @@index([criterionId])
}

// A recruiter's open role, shown to candidates as a requirements post.
model RecruiterPost {
  id           String   @id @default(cuid())
  recruiterId  String
  recruiter    User     @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
  title        String
  companyName  String
  location     String?
  requirements String
  // JSON array of skill names the role needs, e.g. ["Negotiation","Excel"].
  skills       String?
  experience   String?
  employmentType String? // FULL_TIME | PART_TIME | CONTRACT | INTERNSHIP | REMOTE
  status       String   @default("OPEN") // OPEN | CLOSED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([recruiterId])
  @@index([status])
}

// A recruiter's private list of submitted candidates. Notes are only ever read by its owner;
// no candidate route reads this table.
model Shortlist {
  id        String           @id @default(cuid())
  ownerId   String
  owner     User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  entries   ShortlistEntry[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([ownerId, name])
  @@index([ownerId])
}

model ShortlistEntry {
  id          String            @id @default(cuid())
  shortlistId String
  shortlist   Shortlist         @relation(fields: [shortlistId], references: [id], onDelete: Cascade)
  attemptId   String
  attempt     AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  note        String            @default("") // recruiter-only
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([shortlistId, attemptId])
  @@index([attemptId])
}

// One candidate's written answer to an interview follow-up question about a submitted attempt.
// The question itself is derived from the rubric on read, so only the answer is stored.
model AttemptFollowUp {
  id          String            @id @default(cuid())
  attemptId   String
  attempt     AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  criterionId String
  answer      String            @default("")
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([attemptId, criterionId])
  @@index([attemptId])
}

// A short daily practice task. Practice is never marked and never shown to a recruiter.
model DailyTask {
  id              String    @id @default(cuid())
  candidateId     String
  candidate       User      @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  skillId         String
  skill           Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)
  day             String // YYYY-MM-DD, the candidate's local calendar day
  position        Int
  family          String // SALES | SERVICE | OPERATIONS | DATA | PEOPLE | FINANCE | MARKETING | TECHNICAL | GENERAL
  title           String
  scenario        String
  steps           String // JSON array of three prompts the candidate works through
  estimateMinutes Int
  // The checkable question, its private answer key and the candidate's submission.
  difficulty      String    @default("BEGINNER") // BEGINNER | INTERMEDIATE | ADVANCED
  question        String    @default("")
  answerKey       String    @default("{}") // JSON { type, accepted, explanation }; never sent before a submission
  answer          String    @default("")
  attempts        Int       @default(0)
  result          String? // CORRECT | INCORRECT, null before the first submission
  solved          Boolean   @default(false)
  points          Int       @default(0) // points the task is worth
  earnedPoints    Int       @default(0) // points actually awarded; 0 until solved
  status          String    @default("PENDING") // PENDING | DONE
  reflection      String    @default("")
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([candidateId, day, position])
  @@index([candidateId, day])
  @@index([candidateId, earnedPoints])
  @@index([skillId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String
  metadata   String? // JSON text
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
}